{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/common",
  "title": "Shared definitions",
  "description": "Primitive types shared by all v2 schemas (format doc section 11: ids, hashes, encodings, value lists). Patterns end with (?![\\s\\S]) instead of $ because Python's $ also matches before a final LF.",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^(?:[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])"
    },
    "hex32": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{32})(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z)(?![\\s\\S])"
    },
    "date": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01]))(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^(?:sha256:[0-9a-f]{64})(?![\\s\\S])"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "b64u": {
      "type": "string",
      "description": "canonical unpadded base64url (no non-zero trailing bits)",
      "pattern": "^(?:(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?)(?![\\s\\S])"
    },
    "sig": {
      "type": "string",
      "description": "b64u of the 64-byte P-256 signature r||s",
      "pattern": "^(?:[A-Za-z0-9_-]{85}[AQgw])(?![\\s\\S])"
    },
    "pubkey": {
      "type": "string",
      "description": "b64u of the 65-byte uncompressed P-256 point (leading 0x04)",
      "pattern": "^(?:B[A-P][A-Za-z0-9_-]{84}[AEIMQUYcgkosw048])(?![\\s\\S])"
    },
    "token": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_]*)(?![\\s\\S])"
    },
    "addonName": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]{0,39})(?![\\s\\S])",
      "not": {
        "enum": [
          "ticket",
          "status",
          "visibility",
          "people",
          "policy",
          "claim",
          "task",
          "handoff",
          "log",
          "question",
          "gate",
          "verdict",
          "branch",
          "artifact",
          "edit",
          "projection",
          "restore",
          "workspace",
          "member",
          "role",
          "device",
          "settings",
          "grant",
          "addon",
          "invalid",
          "hub",
          "relay"
        ]
      }
    },
    "reservedPrefix": {
      "enum": [
        "ticket",
        "status",
        "visibility",
        "people",
        "policy",
        "claim",
        "task",
        "handoff",
        "log",
        "question",
        "gate",
        "verdict",
        "branch",
        "artifact",
        "edit",
        "projection",
        "restore",
        "workspace",
        "member",
        "role",
        "device",
        "settings",
        "grant",
        "addon",
        "invalid",
        "hub",
        "relay"
      ]
    },
    "personId": {
      "type": "string",
      "pattern": "^(?:p_[0-9a-f]{32})(?![\\s\\S])"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^(?:d_[0-9a-f]{32})(?![\\s\\S])"
    },
    "hostId": {
      "type": "string",
      "pattern": "^(?:h_[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])"
    },
    "grantId": {
      "type": "string",
      "pattern": "^(?:gr_[0-7][0-9A-HJKMNP-TV-Z]{25})(?![\\s\\S])"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^(?:s_[0-7][0-9A-HJKMNP-TV-Z]{25}(?:\\.[1-9][0-9]{0,3}){0,3})(?![\\s\\S])"
    },
    "agentId": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]{0,31})(?![\\s\\S])"
    },
    "ticketKey": {
      "type": "string",
      "description": "<prefix>-<n>, n >= 1 zero-padded to 4 digits, more digits only when needed",
      "pattern": "^(?:[A-Z][A-Z0-9]{0,15}-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,}))(?![\\s\\S])"
    },
    "prefix": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]{0,15})(?![\\s\\S])"
    },
    "acId": {
      "type": "string",
      "pattern": "^(?:AC[1-9][0-9]*)(?![\\s\\S])"
    },
    "taskId": {
      "type": "string",
      "pattern": "^(?:T[1-9][0-9]*)(?![\\s\\S])"
    },
    "questionId": {
      "type": "string",
      "pattern": "^(?:Q[1-9][0-9]*)(?![\\s\\S])"
    },
    "sectionId": {
      "enum": [
        "summary",
        "context",
        "requirements",
        "out_of_scope",
        "plan",
        "decisions",
        "verification",
        "findings",
        "current_state"
      ]
    },
    "anySectionId": {
      "type": "string",
      "pattern": "^(?:summary|context|requirements|out_of_scope|plan|decisions|verification|findings|current_state|[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*)(?![\\s\\S])"
    },
    "gateName": {
      "enum": [
        "requirements",
        "plan",
        "verify",
        "code"
      ]
    },
    "decisionGate": {
      "enum": [
        "requirements",
        "plan",
        "code"
      ]
    },
    "memberRole": {
      "enum": [
        "owner",
        "maintainer",
        "member",
        "viewer"
      ]
    },
    "ticketPeopleRole": {
      "enum": [
        "owner",
        "assignees",
        "reviewers",
        "watchers"
      ]
    },
    "approverToken": {
      "enum": [
        "owner",
        "maintainer",
        "member",
        "ticket_owner",
        "assignees",
        "reviewers",
        "watchers"
      ]
    },
    "questionToRole": {
      "enum": [
        "ticket_owner",
        "assignees",
        "reviewers",
        "watchers"
      ]
    },
    "ticketType": {
      "enum": [
        "feature",
        "bug",
        "chore",
        "spike",
        "epic"
      ]
    },
    "status": {
      "enum": [
        "backlog",
        "open",
        "in_progress",
        "testing",
        "done",
        "closed"
      ]
    },
    "verdictOutcome": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "closeResolution": {
      "enum": [
        "wont_do",
        "duplicate",
        "obsolete",
        "other"
      ]
    },
    "claimReleaseReason": {
      "enum": [
        "released",
        "handoff",
        "expired",
        "grant_ended",
        "member_removed",
        "ticket_done",
        "ticket_closed"
      ]
    },
    "invalidatedCause": {
      "enum": [
        "new_commits",
        "content_changed",
        "policy_changed",
        "member_changed",
        "device_compromised",
        "conflict_resolved",
        "restored"
      ]
    },
    "revokeReason": {
      "enum": [
        "compromised",
        "lost",
        "retired"
      ]
    },
    "repairCause": {
      "enum": [
        "external_edit",
        "projection_mismatch",
        "keys_mismatch"
      ]
    },
    "auth": {
      "enum": [
        "passphrase",
        "secure-enclave",
        "secure-enclave-unlocked",
        "convenience",
        "webauthn",
        "tpm",
        "windows-hello",
        "hub"
      ]
    },
    "grantScope": {
      "enum": [
        "all",
        "workable"
      ]
    },
    "capability": {
      "enum": [
        "serve_http",
        "spawn_agent",
        "pty",
        "network",
        "git_push",
        "choose_model",
        "credential"
      ]
    },
    "coreArtifactKind": {
      "enum": [
        "screenshot",
        "log",
        "report",
        "link",
        "dataset",
        "build",
        "diagram",
        "receipt",
        "feedback",
        "other"
      ]
    },
    "artifactName": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,127})(?![\\s\\S])"
    },
    "repoName": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,99})(?![\\s\\S])"
    },
    "repoIdentity": {
      "type": "string",
      "description": "canonical https:// remote URL (5.7; the length, port, numeric-host and path-segment rules are in validate()), or local:<repo name>",
      "pattern": "^(?:https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~-]+)+|local:[A-Za-z0-9][A-Za-z0-9._-]{0,99})(?![\\s\\S])"
    },
    "refName": {
      "type": "string",
      "description": "refs/heads/<branch>; the git ref-name rules are checked by validate()",
      "pattern": "^(?:refs/heads/[!-~]+)(?![\\s\\S])",
      "maxLength": 300
    },
    "branchName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "description": "a git branch name: no leading -, HEAD, @, refs/ prefix or Unicode 16.0 Cc/Cf/Co/Zs/Zl/Zp/Cn characters, M* mark at the start of any slash-separated component, variation selectors or named invisible look-alikes (F1 §2) (checked by validate())",
      "pattern": "^(?!-|refs/|(?:HEAD|@)(?![\\s\\S]))[\\s\\S]*(?![\\s\\S])"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^(?:https://[!-~]+)(?![\\s\\S])"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))(?![\\s\\S])"
    },
    "operationName": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)(?![\\s\\S])"
    },
    "eventType": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*)(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:[^\\n]+)(?![\\s\\S])"
    },
    "settablePath": {
      "type": "string",
      "pattern": "^(?:ticket\\.(?:title|type|priority|size|labels|parent|blocked_by|due|links|acceptance|tasks)|ticket\\.addons\\.[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*)(?![\\s\\S])"
    },
    "editPath": {
      "type": "string",
      "pattern": "^(?:ticket\\.(?:title|type|priority|size|labels|parent|blocked_by|due|links|acceptance|tasks)|ticket\\.addons\\.[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*|body\\.(?:summary|context|requirements|out_of_scope|plan|decisions|verification|findings|current_state|[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*))(?![\\s\\S])"
    },
    "str": {
      "type": "string",
      "minLength": 1,
      "description": "non-empty text; at most 4096 UTF-8 bytes (checked by validate())"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[^\\n]+)(?![\\s\\S])"
    },
    "safeInt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "posInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "label": {
      "type": "string",
      "pattern": "^(?:[a-z0-9][a-z0-9._-]{0,31})(?![\\s\\S])"
    },
    "sourceList": {
      "type": "array",
      "description": "one entry per repo in links.repos, sorted by repo (checked by validate())",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/repoIdentity"
          },
          "ref": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/refName"
          },
          "sha": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/gitCommit"
          }
        },
        "additionalProperties": false,
        "required": [
          "repo",
          "ref",
          "sha"
        ]
      }
    },
    "visibility": {
      "oneOf": [
        {
          "const": "workspace"
        },
        {
          "type": "object",
          "properties": {
            "restricted": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/personRef"
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "restricted"
          ]
        }
      ]
    },
    "option": {
      "type": "object",
      "description": "Section 5.6.1. One option of a choice question: key, title (label), one-line text, 1..3 [label, value] facts, cost. Code-point limits are checked by orch.canon.question.",
      "properties": {
        "key": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
        },
        "label": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        },
        "text": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/questionFact"
          }
        },
        "cost": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ]
    },
    "questionFact": {
      "type": "array",
      "description": "Section 5.6.1. Exactly [label, value].",
      "prefixItems": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        },
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        }
      ],
      "items": false,
      "minItems": 2
    },
    "question": {
      "type": "object",
      "description": "Section 5.6.1. One shape; kind choice (2..6 options, recommended?, allow_other?) or text (an open question, no options). Limits, text rules and distinct titles are checked by orch.canon.question.",
      "properties": {
        "id": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/questionId"
        },
        "to": {
          "oneOf": [
            {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/personRef"
            },
            {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/questionToRole"
            }
          ]
        },
        "text": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
        },
        "kind": {
          "enum": [
            "choice",
            "text"
          ]
        },
        "why": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
        },
        "details": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/option"
          },
          "minItems": 2,
          "maxItems": 6
        },
        "recommended": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
        },
        "allow_other": {
          "const": true
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "to",
        "text",
        "blocking",
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "choice"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "options": false,
              "recommended": false,
              "allow_other": false
            }
          }
        }
      ]
    },
    "gatePolicy": {
      "type": "object",
      "properties": {
        "approvers": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "count": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
        },
        "not": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
          },
          "uniqueItems": true
        },
        "applies": {
          "oneOf": [
            {
              "enum": [
                "all",
                "off"
              ]
            },
            {
              "type": "array",
              "items": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketType"
              },
              "uniqueItems": true,
              "minItems": 1
            }
          ]
        },
        "independent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "approvers",
        "count",
        "not",
        "applies",
        "independent"
      ]
    },
    "codePolicy": {
      "allOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
        }
      ],
      "properties": {
        "not": {
          "contains": {
            "const": "assignees"
          }
        },
        "independent": {
          "const": true
        }
      },
      "description": "D59: the code gate always excludes assignees and is independent"
    },
    "gatesAll": {
      "type": "object",
      "properties": {
        "requirements": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
        },
        "plan": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
        },
        "verify": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
        },
        "code": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/codePolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "requirements",
        "plan",
        "verify",
        "code"
      ]
    },
    "gatesPartial": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "requirements": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
        },
        "plan": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
        },
        "verify": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
        },
        "code": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/codePolicy"
        }
      },
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "properties": {
        "o": {
          "type": "object",
          "properties": {
            "v": {
              "const": 2
            },
            "suite": {
              "const": 2
            },
            "kind": {
              "const": "ws_delegation"
            },
            "workspace_id": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
            },
            "wsk_pub": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/pubkey"
            },
            "owner_person_id": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
            },
            "client_hosted": {
              "type": "boolean"
            },
            "issued_ms": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
            }
          },
          "additionalProperties": false,
          "required": [
            "v",
            "suite",
            "kind",
            "workspace_id",
            "wsk_pub",
            "owner_person_id",
            "client_hosted",
            "issued_ms"
          ]
        },
        "sig": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
        }
      },
      "additionalProperties": false,
      "required": [
        "o",
        "sig"
      ]
    },
    "revocation": {
      "type": "object",
      "properties": {
        "o": {
          "type": "object",
          "properties": {
            "v": {
              "const": 2
            },
            "suite": {
              "const": 2
            },
            "kind": {
              "const": "revocation"
            },
            "person_id": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
            },
            "device_id": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
            },
            "revoked_ms": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
            },
            "reason": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/revokeReason"
            }
          },
          "additionalProperties": false,
